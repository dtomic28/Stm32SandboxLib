{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "base-windows",
            "hidden": true,
            "inherits": "base",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64"
        },
        {
            "name": "debug",
            "inherits": "base-windows",
            "displayName": "Debug (Windows)",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "inherits": "base-windows",
            "displayName": "Release (Windows)",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ci",
            "inherits": "base",
            "generator": "Ninja",
            "displayName": "CI — all sublibs, tests and examples enabled",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":           "Release",
                "TOMKO_LIB_ENABLE_TESTS":     "ON",
                "TOMKO_LIB_ENABLE_EXAMPLE":   "ON",
                "TOMKO_ENABLE_CAN_DATABASE":  "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "configuration": "Debug"
        },
        {
            "name": "release",
            "configurePreset": "release",
            "configuration": "Release"
        },
        {
            "name": "ci",
            "configurePreset": "ci"
        }
    ],
    "testPresets": [
        {
            "name": "ci",
            "configurePreset": "ci",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
